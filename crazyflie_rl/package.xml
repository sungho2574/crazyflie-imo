  <version>0.0.1</version>
  <description>Crazyswarm2 기반 Crazyflie 강화학습 레이싱 정책 실행 패키지</description>
  <maintainer email="todo@todo.com">todo</maintainer>
  <license>MIT</license>

  <depend>crazyflie</depend>
  <depend>crazyflie_py</depend>
  <depend>crazyflie_interfaces</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-numpy</depend>
