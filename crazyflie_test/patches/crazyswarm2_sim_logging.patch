+                self._publish_logs(states_next, actions)
+
+    def _publish_logs(self, states_next, actions):
+        """pose / imu_raw / motor_pwm 를 실기체와 동일 포맷으로 낸다.
+
+        imu_raw.values = [acc.x, acc.y, acc.z (g), gyro.x, gyro.y, gyro.z (deg/s)]
+        motor_pwm.values = [m1, m2, m3, m4]  (0..65535)
+        가속도계는 비추력(specific force)을 읽는다: drag-free 모델에서 바디프레임
+        [0, 0, 총추력/mass]. 호버 시 총추력=mg → acc_z≈1g. gyro = 바디 각속도.
+        """
+        stamp = self.get_clock().now().to_msg()
+        for state, action, (name, cf) in zip(states_next, actions, self.cfs.items()):
+            pose = PoseStamped()
+            pose.header.stamp = stamp
+            pose.header.frame_id = 'world'
+            pose.pose.position.x = float(state.pos[0])
+            pose.pose.position.y = float(state.pos[1])
+            pose.pose.position.z = float(state.pos[2])
+            pose.pose.orientation.w = float(state.quat[0])
+            pose.pose.orientation.x = float(state.quat[1])
+            pose.pose.orientation.y = float(state.quat[2])
+            pose.pose.orientation.z = float(state.quat[3])
+            self.pose_pubs[name].publish(pose)
+
+            thrust = float(np.sum(_rpm_to_force(action.rpm)))     # 총추력 [N]
+            acc_z_g = thrust / (_DEFAULT_MASS * 9.81)             # 비추력 [g]
+            gyro = np.asarray(state.omega, dtype=float) * _RAD2DEG
+            imu = LogDataGeneric()
+            imu.header.stamp = stamp
+            imu.header.frame_id = name
+            imu.values = [0.0, 0.0, float(acc_z_g),
+                          float(gyro[0]), float(gyro[1]), float(gyro[2])]
+            self.imu_pubs[name].publish(imu)
+
+            m = cf.motors_thrust_pwm.motors
+            pwm = LogDataGeneric()
+            pwm.header.stamp = stamp
+            pwm.header.frame_id = name
+            pwm.values = [float(m.m1), float(m.m2), float(m.m3), float(m.m4)]
+            self.pwm_pubs[name].publish(pwm)
+
