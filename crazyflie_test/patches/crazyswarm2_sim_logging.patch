+# 학습 데이터 수집용 로그 토픽 (crazyflie-imo 추가):
+# sim 은 원래 firmware_logging 을 무시해 imu_raw/motor_pwm/pose 를 안 낸다. 실기체와
+# 같은 토픽·포맷으로 내보내, 기존 rosbag/bag_to_csv 파이프라인을 그대로 쓸 수 있게 한다.
+_RAD2DEG = 180.0 / math.pi
+_DEFAULT_MASS = 0.034      # kg (crazyflie_sim Quadrotor 기본값)
+
+
+def _rpm_to_force(rpm):
+    """RPM → 로터 추력 [N] (backend/np.py 의 rpm_to_force 와 동일 계수)."""
+    p = [2.55077341e-08, -4.92422570e-05, -1.51910248e-01]
+    grams = np.polyval(p, np.asarray(rpm, dtype=float))
+    return np.maximum(grams * 9.81 / 1000.0, 0.0)
+
